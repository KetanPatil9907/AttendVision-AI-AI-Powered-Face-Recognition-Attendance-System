# Smart Attendance System - backend environment configuration.
# Copy to .env and adjust values

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Use "sqlite" for a zero-setup local run, or "postgres" for production/Docker.
DB_ENGINE=sqlite
POSTGRES_DB=smart_attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth ---
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
REMEMBER_ME_REFRESH_DAYS=30

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI / Face recognition ---
# AI_MODELS_DIR defaults to backend/media/models
AI_MODELS_DIR=
AI_DETECTOR_MODEL=face_detection_yunet_2023mar.onnx
AI_RECOGNITION_MODEL=w600k_r50.onnx
# Cosine-similarity threshold for a confident match (0.0 - 1.0).
# Measured on this gallery: enrolled students score 0.85-1.00 (same photo
# ~1.00, a DIFFERENT photo of the same student >= 0.85) while unenrolled
# faces score 0.03-0.16 and the closest cross-student pair sits at 0.21 -
# 0.70 keeps a wide safety gap on both sides. (0.35 would be too low:
# unenrolled faces could start matching.)
RECOGNITION_THRESHOLD=0.70
# The best match must beat the runner-up STUDENT by this cosine gap,
# otherwise the face is reported as "ambiguous" (too close to call) instead
# of guessing between look-alike classmates. Genuine margins measure
# >= 0.70; rejected probes measure <= 0.01.
RECOGNITION_MARGIN=0.15
# Face quality gate - a face must clear ALL of these before an embedding is
# generated. Failing faces are reported as LOW_QUALITY and never marked.
# Measured defaults: genuine face crops score sharpness >= 73 and >= 120 px
# wide; heavy blur scores <= 8. Keep thresholds well below genuine values so
# normal classroom faces are never rejected.
RECOGNITION_MIN_FACE_PX=40
RECOGNITION_MIN_FACE_RATIO=0.02
RECOGNITION_MIN_DETECTOR_SCORE=0.5
RECOGNITION_MIN_FACE_SHARPNESS=20
# Registration photos per student (3-5 varied photos recommended:
# front-facing, slight angles, different lighting).
MAX_STUDENT_PHOTOS=5

# --- Misc ---
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=10