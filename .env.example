# Smart Attendance System - Docker Compose environment.
# Copy to .env (repo root) and adjust.
# backend/.env still controls the details of a local (non-Docker) run.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Postgres
POSTGRES_DB=smart_attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance

# Web
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080

# AI
RECOGNITION_THRESHOLD=0.35

# Auth
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
REMEMBER_ME_REFRESH_DAYS=30